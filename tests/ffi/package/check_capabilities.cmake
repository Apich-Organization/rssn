cmake_minimum_required(VERSION 3.20)
execute_process(COMMAND "${CLIENT}" manifest RESULT_VARIABLE status
    OUTPUT_VARIABLE manifest ERROR_VARIABLE detail TIMEOUT 60)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Packaged manifest client exited ${status}\n${detail}")
endif()
string(JSON features GET "${manifest}" features)
foreach(feature jit jit_branch jit_index npy)
    string(JSON enabled GET "${features}" "${feature}")
    if(NOT enabled)
        message(FATAL_ERROR "The release manifest is missing ${feature} support")
    endif()
endforeach()
string(JSON count LENGTH "${features}" devices)
set(devices)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE "${last}")
        string(JSON device GET "${features}" devices "${index}")
        list(APPEND devices "${device}")
    endforeach()
endif()
if(NOT "gpu-wgpu" IN_LIST devices)
    message(FATAL_ERROR "The release manifest is missing wgpu support")
endif()
message(STATUS "Release manifest confirms Cranelift, NumPy I/O and wgpu capabilities")
