--- |
  target triple = "x86_64-pc-windows-msvc"
  declare i32 @opaque()
  define i64 @edge_restore(i32 %choose) { ret i64 0 }
...
---
name: edge_restore
tracksRegLiveness: true
noPhis: true
noVRegs: true
constants:
  - id: 0
    value: 'i64 782341'
    alignment: 8
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $ecx

    MOV64mi32 %stack.0, 1, $noreg, 0, $noreg, 298919 :: (store (s64) into %stack.0)
    TEST32rr $ecx, $ecx, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.2

  bb.1:
    successors: %bb.3(0x20000000), %bb.4(0x60000000)

    CALL64pcrel32 @opaque, csr_win64, implicit $rsp, implicit-def $rsp, implicit-def $eax
    $r10 = MOV64rm $rip, 1, $noreg, %const.0, $noreg :: (load (s64) from constant-pool)
    $r11 = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    TEST32rr $eax, $eax, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.4

  bb.2:
    successors: %bb.3(0x20000000), %bb.4(0x60000000)

    CALL64pcrel32 @opaque, csr_win64, implicit $rsp, implicit-def $rsp, implicit-def $eax
    $r10 = MOV64rm $rip, 1, $noreg, %const.0, $noreg :: (load (s64) from constant-pool)
    $r11 = MOV64rm %stack.0, 1, $noreg, 0, $noreg :: (load (s64) from %stack.0)
    TEST32rr $eax, $eax, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.4

  bb.3:
    liveins: $r10, $r11

    $rax = MOV64rr $r10
    $rax = ADD64rr $rax, $r11, implicit-def dead $eflags
    RET64 implicit $rax

  bb.4:
    $rax = MOV32ri64 0
    RET64 implicit $rax
...
