# The package namespace.
#
# The C bridge registers its entry points (`R_registerRoutines` with
# `R_forceSymbols`), so `.Call()` here always passes a symbol object, never a
# string: a typo is a load-time error rather than a run-time one.

useDynLib(rssn, .registration = TRUE)

# Sessions, terms, configuration and computation.
export(
  rssn_session, default_session, with_session, session_ptr, rssn_close,
  rssn_config, config_ptr,
  cfg_symbolic, cfg_numeric, cfg_bind, cfg_assume, cfg_budget,
  cfg_dimension_mode, cfg_bypass_dimensions, cfg_dimension,
  cfg_define_base_dimension,
  assumption, dimension_mode,
  sym, parse_term, term, rational, int_term, real_term,
  compute, compute_all, compute_json, compute_bincode, compute_all_bincode,
  simplify, eval_term, dimension, dimension_report,
  term_text, term_latex, term_typst, term_pretty, term_value, to_float, handle,
  answer, is_answer,
  # dynamic values
  call_value, value_of, value_new, value_kind, value_tensor, value_json,
  value_term, value_text, value_float, value_len, value_count, value_cell, tensor,
  # host callbacks
  rssn_callback, callback_signatures, parse_signature, callback_count, callback_cell,
  # simulations, units, constants
  sim_run, sim_names, sim_params, sim_defaults,
  unit_get, unit_names, units_table, unit_scale, UNITS, UNIT_BY_ALIAS,
  constant_get, constants_table, constant_value, CONSTANTS, CONSTANT_BY_SYMBOL,
  SCENARIOS, SCENARIO_PARAMS, VALUE_KINDS, rssn_condition,
  # operator discovery
  op_apply, op_help, op_table, op_names, OPERATORS, OPS,
  manifest, manifest_json, manifest_hash, MANIFEST_META,
  rssn_version, rssn_library, rssn_load,
  json_decode, json_encode
)

# Every generated operator facade, `rssn_<name>`.  A pattern export keeps the
# namespace file readable while still exporting all of them.
exportPattern("^rssn_[a-zA-Z]")

S3method(print, rssn_session)
S3method(format, rssn_session)
S3method(print, rssn_term)
S3method(format, rssn_term)
S3method(as.character, rssn_term)
S3method(print, rssn_answer)
S3method(format, rssn_answer)
S3method(print, rssn_config)
S3method(print, rssn_value)
S3method(format, rssn_value)
S3method(as.character, rssn_value)
S3method(as.numeric, rssn_value)
S3method(as.numeric, rssn_term)
S3method(length, rssn_value)
S3method("[[", rssn_value)
S3method(Ops, rssn_term)
S3method(Math, rssn_term)
S3method(Summary, rssn_term)
S3method(close, rssn_session)
S3method(close, rssn_config)
S3method(close, rssn_value)
S3method(close, rssn_callback)
S3method(print, rssn_callback)
S3method(print, rssn_operator)
